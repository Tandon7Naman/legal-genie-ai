# Supabase project configuration (these values are safe to be public/client-side)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# NOTE: Server-side secrets — LOVABLE_API_KEY, ECOURTS_API_KEY and
# SUPABASE_SERVICE_ROLE_KEY — must never be placed here. They live in the
# Supabase function secrets and are read only by server-side edge functions,
# so provider keys never reach the browser.
